{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "adf-cars-yash-81"
        },
        "ls_sql_db_password": {
            "type": "secureString",
            "metadata": "Secure string for 'password' of 'ls_sql_db'"
        },
        "ls_datalake_accountKey": {
            "type": "secureString",
            "metadata": "Secure string for 'accountKey' of 'ls_datalake'"
        },
        "ls_databricks_accessToken": {
            "type": "secureString",
            "metadata": "Secure string for 'accessToken' of 'ls_databricks'"
        },
        "ls_sql_db_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "carsalesserver81.database.windows.net"
        },
        "ls_sql_db_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "car-sales-db"
        },
        "ls_sql_db_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "adm"
        },
        "ls_github_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://raw.githubusercontent.com"
        },
        "ls_datalake_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://carsalesdatalake81.dfs.core.windows.net/"
        },
        "ls_databricks_properties_typeProperties_existingClusterId": {
            "type": "string",
            "defaultValue": "0825-150758-gjy5kx97"
        },
        "containerUri": {
            "type": "string",
            "metadata": "URI to storage account containing linked ARM templates"
        },
        "containerSasToken": {
            "type": "string",
            "metadata": "Sas token to storage account containing linked ARM templates"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "adf-cars-yash-81_ArmTemplate_0",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "ls_sql_db_password": {
                        "value": "[parameters('ls_sql_db_password')]"
                    },
                    "ls_datalake_accountKey": {
                        "value": "[parameters('ls_datalake_accountKey')]"
                    },
                    "ls_databricks_accessToken": {
                        "value": "[parameters('ls_databricks_accessToken')]"
                    },
                    "ls_sql_db_properties_typeProperties_server": {
                        "value": "[parameters('ls_sql_db_properties_typeProperties_server')]"
                    },
                    "ls_sql_db_properties_typeProperties_database": {
                        "value": "[parameters('ls_sql_db_properties_typeProperties_database')]"
                    },
                    "ls_sql_db_properties_typeProperties_userName": {
                        "value": "[parameters('ls_sql_db_properties_typeProperties_userName')]"
                    },
                    "ls_github_properties_typeProperties_url": {
                        "value": "[parameters('ls_github_properties_typeProperties_url')]"
                    },
                    "ls_datalake_properties_typeProperties_url": {
                        "value": "[parameters('ls_datalake_properties_typeProperties_url')]"
                    },
                    "ls_databricks_properties_typeProperties_existingClusterId": {
                        "value": "[parameters('ls_databricks_properties_typeProperties_existingClusterId')]"
                    }
                }
            },
            "dependsOn": []
        }
    ]
}